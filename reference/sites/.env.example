# Documentation only. Never commit real keys. Hosted values use Sites environment settings.
# demo: QR rehearsal and editorial demo. manual_qr: real manual reconciliation.
# Production requires CONTENT_MODE=openai, an approved key, and explicit admin IDs.
PAYMENTS_MODE=demo
ADMIN_USER_IDS=
CONTENT_MODE=demo
# ONLY on a confirmed owner-private Site. Remove before changing its audience.
DEMO_ADMIN_ACCESS=owner-private
# Prepared adapter; not called by the demo. Requires separate API spending approval.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_INPUT_USD_M=0.25
AI_OUTPUT_USD_M=2
# Budget assumption, NOT a current FX quote.
USD_PYG=7500
